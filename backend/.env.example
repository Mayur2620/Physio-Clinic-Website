PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=physio_app
DB_PASSWORD=change-me
DB_NAME=physio_clinic

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me


# Comma-separated list of frontend origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Twilio — leave blank to disable SMS/WhatsApp appointment notifications
# TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN: from the Twilio Console dashboard
# TWILIO_SMS_FROM: your Twilio phone number, e.g. +15551234567
# TWILIO_SMS_TEMPLATE: required on Twilio trials; use sms_appointment_reminders
# TWILIO_CLINICIAN_NAME: name shown in personalized appointment messages
# TWILIO_WHATSAPP_FROM: your WhatsApp sender, e.g. +14155238886 (sandbox) or an approved number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_SMS_TEMPLATE=
TWILIO_CLINICIAN_NAME=
TWILIO_WHATSAPP_FROM=
